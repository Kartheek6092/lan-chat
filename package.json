{
  "name": "lan-chat-next",
  "version": "0.2.0",
  "private": true,
  "description": "Phase 1 (Next.js): end-to-end encrypted chat between browsers on the same Wi-Fi, no internet needed",
  "scripts": {
    "cert": "node scripts/gen-cert.js",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 node server.js",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production node server.js"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "cross-env": "^7.0.3",
    "selfsigned": "^2.4.1",
    "typescript": "^5.6.0"
  }
}
